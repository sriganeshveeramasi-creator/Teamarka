# MongoDB Connection String (Replace with your local mongod or MongoDB Atlas cluster URL)
MONGODB_URI=mongodb://localhost:27017/team_arka
# Example MongoDB Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/team_arka?retryWrites=true&w=majority

# JWT Secret for Secure HTTP-Only Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
