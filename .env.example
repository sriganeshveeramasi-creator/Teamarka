# MongoDB Atlas Connection String (set in Vercel or .env.local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/team_arka?retryWrites=true&w=majority

# JWT Secret for Secure HTTP-Only Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
